{
  "name": "streamlink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "StreamLink: a shared One Health record for every urban stream (OneAquaHealth IEEE Global Hackathon 2026)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundles": "tsx scripts/gen-bundles.ts",
    "validate": "bash scripts/validate.sh"
  },
  "dependencies": {
    "leaflet": "1.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
