{
  "name": "streamlink",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "StreamLink: a shared One Health record for every urban stream (OneAquaHealth IEEE Global Hackathon 2026)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/inject-sw-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundles": "tsx scripts/gen-bundles.ts",
    "validate": "tsx scripts/gen-bundles.ts && bash scripts/validate.sh && node scripts/publish-validation.mjs",
    "e2e": "node scripts/e2e.mjs",
    "a11y": "node scripts/a11y.mjs",
    "offline": "node scripts/offline-check.mjs",
    "sandbox": "tsx scripts/sandbox-demo.mjs --write && tsx scripts/sandbox-lifecycle.mjs",
    "sandbox:cleanup": "node scripts/sandbox-cleanup.mjs --delete",
    "record": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "leaflet": "1.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
